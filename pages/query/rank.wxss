.page { padding-top: 16rpx; }
.opt { flex: 1; background: #fff; border: 2rpx solid #e6e6e6; border-radius: 16rpx; padding: 20rpx 0; text-align: center; }
.opt--on { border-color: #ff7834; background: rgba(255,120,52,0.04); }
.opt__txt { font-size: 28rpx; font-weight: 600; color: #ff7834; }
.score-input { font-size: 80rpx; font-weight: 700; color: #ff7834; text-align: center; padding: 16rpx 0; }
.result { text-align: center; padding: 48rpx 24rpx; }
.result__label { font-size: 26rpx; color: #666; }
.result__num { font-size: 96rpx; font-weight: 700; color: #ff7834; line-height: 1.1; }
.result__unit { font-size: 28rpx; color: #ff5504; }
.opt--sm { padding: 16rpx 0; }

.row { display: flex; justify-content: space-between; align-items: center;
       padding: 20rpx 4rpx; border-bottom: 1rpx solid #f2f2f2; }
.row__l { flex: 1; min-width: 0; }
.row__major { font-size: 28rpx; color: #333; font-weight: 600; }
.row__r { text-align: right; }
.picker-val { font-size: 28rpx; color: #ff7834; font-weight: 600; }
.tip { text-align: center; color: #999; font-size: 24rpx; padding: 16rpx 0; }
