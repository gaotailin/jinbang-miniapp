<view class="page">

  <!-- ===== 1. 顶部导航 ===== -->
  <view class="topbar">
    <view class="topbar__name">九色鹿前程助手</view>
    <view wx:if="{{!isVip}}" class="topbar__quota" bindtap="goVip">今日剩 {{remaining}} 次</view>
    <view wx:else class="topbar__quota topbar__quota--vip" bindtap="goVip">👑 会员</view>
    <view class="topbar__tabs">
      <view class="topbar__tab {{category==='normal'?'topbar__tab--on':''}}" data-cat="normal" bindtap="switchCat">普通类</view>
      <view class="topbar__tab {{category==='art'?'topbar__tab--on':''}}" data-cat="art" bindtap="switchCat">艺术类</view>
    </view>
  </view>

  <!-- ===== 2. 搜索框 ===== -->
  <view class="search-bar" bindtap="goSearch">
    <icon name="search" size="30" color="#999999" />
    <text class="search-bar__ph">输入要查询的大学或专业</text>
  </view>

  <!-- ===== 3a. 艺术类面板（点「艺术类」tab 显示）===== -->
  <view wx:if="{{category==='art'}}" class="art-panel">
    <view class="art-panel__main" hover-class="act--press" hover-stay-time="80" bindtap="goArtCalc">
      <view class="art-panel__l">
        <view class="art-panel__t">艺术类综合分测算</view>
        <view class="art-panel__s">31省折算公式 · 输文化分+专业分秒出投档分</view>
      </view>
      <view class="art-panel__arrow">›</view>
    </view>
    <view class="art-grid">
      <view class="art-cell" hover-class="grid__i--press" hover-stay-time="80" bindtap="goArtSchools">
        <view class="art-cell__t">艺术类院校库</view>
        <view class="art-cell__s">独立艺术院校 · 按省/类型查</view>
      </view>
      <view class="art-cell" hover-class="grid__i--press" hover-stay-time="80" bindtap="goArtCalc">
        <view class="art-cell__t">综合分测算</view>
        <view class="art-cell__s">31省投档分折算</view>
      </view>
    </view>
    <view class="art-panel__tip">更多艺术类功能（录取概率/招生计划）陆续上线</view>
  </view>

  <!-- ===== 3. 成绩绑定卡（1:1 对标掌上核心模块·普通类）===== -->
  <view wx:if="{{category!=='art'}}" class="score-card">
    <!-- 卡头：定位 + 科类 + 编辑 -->
    <view class="score-card__hd">
      <view class="score-card__loc">
        <text class="score-card__dot">●</text>
        <text class="score-card__prov">{{profile.province || '内蒙古'}}</text>
        <text class="score-card__sub">{{profile.subject || '物理类'}}</text>
      </view>
      <view class="score-card__edit" bindtap="goPick">{{hasData ? '编辑成绩' : '录入成绩'}}</view>
    </view>

    <!-- 已绑定：大分数 + 位次 -->
    <view wx:if="{{hasData}}" class="score-card__body">
      <view class="score-metric">
        <view class="score-metric__num">{{profile.score}}</view>
        <view class="score-metric__label">高考分数</view>
      </view>
      <view class="score-card__divider"></view>
      <view class="score-metric">
        <view class="score-metric__num score-metric__num--rank">{{profile.rank}}</view>
        <view class="score-metric__label">高考位次</view>
      </view>
    </view>
    <!-- 未绑定：引导 -->
    <view wx:else class="score-card__empty">
      <view class="score-card__empty-txt">绑定高考成绩，解锁冲稳保分析与志愿推荐</view>
    </view>

    <!-- 开始填报 CTA（橙渐变，掌上灵魂按钮）-->
    <view class="score-card__cta" hover-class="score-card__cta--press" hover-stay-time="80" bindtap="goPick">
      {{hasData ? '开始填报' : '立即输入成绩'}}
    </view>
  </view>

  <!-- ===== 4. 功能横排（对标掌上：志愿表/订单/会员/更多 → 九色鹿真实功能）===== -->
  <view wx:if="{{category!=='art'}}" class="quick">
    <view class="quick__i" hover-class="grid__i--press" hover-stay-time="80" bindtap="goVolunteer">
      <view class="quick__ic quick__ic--v"><icon name="fill" size="40" color="#ff7834" /></view>
      <view class="quick__t">志愿表</view>
    </view>
    <view class="quick__i" hover-class="grid__i--press" hover-stay-time="80" bindtap="goPick">
      <view class="quick__ic quick__ic--p"><icon name="same" size="40" color="#8b5cf6" /></view>
      <view class="quick__t">选校单</view>
    </view>
    <view class="quick__i" hover-class="grid__i--press" hover-stay-time="80" bindtap="goReport">
      <view class="quick__ic quick__ic--r"><icon name="trophy" size="40" color="#27ae60" /></view>
      <view class="quick__t">升学报告</view>
    </view>
    <view class="quick__i" hover-class="grid__i--press" hover-stay-time="80" bindtap="goServices">
      <view class="quick__ic quick__ic--s"><icon name="more" size="40" color="#ff7834" /></view>
      <view class="quick__t">更多服务</view>
    </view>
  </view>

  <!-- ===== 5. 填报入口横条（对标掌上：提前批/艺术/严审 → 九色鹿真实落点）===== -->
  <view wx:if="{{category!=='art'}}" class="entry">
    <view class="entry__i" hover-class="entry__i--press" hover-stay-time="80" bindtap="goAutofill">
      <view class="entry__name">智能填报</view>
      <view class="entry__desc">一键生成方案</view>
    </view>
    <view class="entry__i" hover-class="entry__i--press" hover-stay-time="80" bindtap="goProbability">
      <view class="entry__name">录取概率</view>
      <view class="entry__desc">测冲稳保</view>
    </view>
    <view class="entry__i" hover-class="entry__i--press" hover-stay-time="80" bindtap="goArtCalc">
      <view class="entry__name">艺术类</view>
      <view class="entry__desc">综合分测算</view>
    </view>
  </view>

  <!-- ===== 6. 金刚区两大格（1:1 对标掌上：选大学 / 挑专业）===== -->
  <view wx:if="{{category!=='art'}}" class="king">
    <view class="king__i king__i--school" hover-class="king__i--press" hover-stay-time="80" bindtap="goSearch">
      <view class="king__txt">
        <view class="king__title">选大学</view>
        <view class="king__sub">3251所院校 · 城市/层次筛选</view>
      </view>
      <view class="king__ic"><icon name="search" size="56" color="#ff7834" /></view>
    </view>
    <view class="king__i king__i--major" hover-class="king__i--press" hover-stay-time="80" bindtap="goMajor">
      <view class="king__txt">
        <view class="king__title">挑专业</view>
        <view class="king__sub">1855个专业 · 三级门类查询</view>
      </view>
      <view class="king__ic"><icon name="major" size="56" color="#2b86d9" /></view>
    </view>
  </view>

  <!-- ===== 7. 冲稳保三栏（有数据时，九色鹿增值保留）===== -->
  <view wx:if="{{category!=='art' && hasData}}" class="bands-card">
    <view class="bands-card__hd">你的冲稳保</view>
    <view class="hero__bands">
      <view class="band band--chong" bindtap="goPick">
        <text class="band__num">{{bands.chong}}</text>
        <view class="band__bot"><text class="band__label">可冲击</text><text class="band__arrow">›</text></view>
      </view>
      <view class="band band--wen" bindtap="goPick">
        <text class="band__num">{{bands.wen}}</text>
        <view class="band__bot"><text class="band__label">较稳妥</text><text class="band__arrow">›</text></view>
      </view>
      <view class="band band--bao" bindtap="goPick">
        <text class="band__num">{{bands.bao}}</text>
        <view class="band__bot"><text class="band__label">可保底</text><text class="band__arrow">›</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 8. 高校排行榜预览（真实数据，保留）===== -->
  <view wx:if="{{rankBoards.length}}" class="rk-sec">
    <view class="rk-sec__hd" bindtap="goRanking">
      <text class="rk-sec__title">高校排行榜</text>
      <text class="rk-sec__more">查看全部 ›</text>
    </view>
    <scroll-view class="rk-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view wx:for="{{rankBoards}}" wx:key="key" class="rk-card" hover-class="rk-card--press" hover-stay-time="80" bindtap="goRanking">
        <view class="rk-card__t">{{item.title}}</view>
        <view wx:for="{{item.items}}" wx:for-item="it" wx:key="school" class="rk-row">
          <text class="rk-row__n rk-row__n--{{it.rank<=3?it.rank:'x'}}">{{it.rank}}</text>
          <text class="rk-row__s">{{it.school}}</text>
          <text class="rk-row__m">{{it.metric}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 引导文案 -->
  <view class="tagline" bindtap="goAbout">
    <text>测兴趣 → 智能选校 → 冲稳保填报 · 一站式科学报考</text>
  </view>
</view>
