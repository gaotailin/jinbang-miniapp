/* =========================================================
   首页 index · 1:1 对标掌上志愿布局（clone-1to1 橙色孪生版）
   区块：顶栏 → 搜索 → 成绩绑定卡 → 功能横排 → 填报入口
        → 金刚两大格 → 冲稳保 → 排行榜 → 引导
   设计对齐掌上：卡片左右边距 24rpx、圆角 16~20rpx、字号 24~32rpx、横向橙渐变 CTA
   ========================================================= */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff0e3 0%, #fff8f0 16%, #F7F7F7 40%);
  padding-bottom: 180rpx;
}

/* ===== 1. 顶部导航 ===== */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx 0;
}
.topbar__name { font-size: 38rpx; font-weight: 800; color: #1a1a1a; }
.topbar__quota { font-size: 22rpx; color: #ff5504; background: #fff0e3; padding: 6rpx 16rpx; border-radius: 20rpx; }
.topbar__quota--vip { color: #B8860B; background: #fff0e3; }
.topbar__tabs { display: flex; gap: 36rpx; }
.topbar__tab {
  font-size: 28rpx; color: #aaa; font-weight: 400;
  padding-bottom: 10rpx; border-bottom: 4rpx solid transparent; transition: all 0.2s;
}
.topbar__tab--on { color: #ff5504; font-weight: 700; border-bottom-color: #ff5504; }

/* ===== 2. 搜索框 ===== */
.search-bar {
  display: flex; align-items: center; gap: 14rpx;
  margin: 24rpx 24rpx 20rpx;
  height: 82rpx; padding: 0 28rpx;
  background: #fff; border-radius: 44rpx;
  box-shadow: 0 4px 16rpx rgba(0,0,0,0.04);
}
.search-bar__ph { font-size: 28rpx; color: #bbb; }

/* ===== 3. 成绩绑定卡（掌上核心模块）===== */
.score-card {
  margin: 0 24rpx 24rpx;
  background: #fff; border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(255,85,4,0.08);
  padding: 28rpx 28rpx 24rpx;
}
.score-card__hd {
  display: flex; align-items: center; justify-content: space-between;
}
.score-card__loc { display: flex; align-items: center; gap: 12rpx; }
.score-card__dot { font-size: 18rpx; color: #ff7834; }
.score-card__prov { font-size: 30rpx; font-weight: 700; color: #1e1e1e; }
.score-card__sub {
  font-size: 22rpx; color: #ff5504; background: #fff0e3;
  padding: 4rpx 14rpx; border-radius: 8rpx; font-weight: 500;
}
.score-card__edit {
  font-size: 24rpx; color: #ff5504; font-weight: 600;
  padding: 8rpx 22rpx; background: #fff0e3; border-radius: 22rpx;
}
.score-card__body {
  display: flex; align-items: center; justify-content: space-around;
  padding: 32rpx 0 24rpx;
}
.score-metric { flex: 1; text-align: center; }
.score-metric__num {
  font-size: 64rpx; font-weight: 800; color: #ff5504; line-height: 1.1;
  font-family: -apple-system, 'DIN Alternate', sans-serif;
}
.score-metric__num--rank { color: #1e1e1e; }
.score-metric__label { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.score-card__divider { width: 1rpx; height: 72rpx; background: #eee; }
.score-card__empty { padding: 40rpx 0 28rpx; text-align: center; }
.score-card__empty-txt { font-size: 26rpx; color: #999; line-height: 1.6; }
.score-card__cta {
  margin-top: 8rpx; height: 88rpx; border-radius: 44rpx;
  background: linear-gradient(90deg, #ff7834, #ff5504);
  color: #fff; font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(255,85,4,0.28);
}
.score-card__cta--press { transform: scale(0.98); opacity: 0.92; }

/* ===== 4. 功能横排（4 格）===== */
.quick {
  display: flex; margin: 0 24rpx 24rpx;
  background: #fff; border-radius: 20rpx; padding: 24rpx 0;
  box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.04);
}
.quick__i { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.quick__ic {
  width: 84rpx; height: 84rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.quick__ic--v { background: #fff0e3; }
.quick__ic--p { background: #F3E8FF; }
.quick__ic--r { background: #E8F8F0; }
.quick__ic--s { background: #fff0e3; }
.quick__t { font-size: 24rpx; color: #555; font-weight: 500; }

/* ===== 5. 填报入口横条（3 格）===== */
.entry { display: flex; gap: 16rpx; margin: 0 24rpx 24rpx; }
.entry__i {
  flex: 1; border-radius: 16rpx; padding: 24rpx 20rpx;
  background: #fff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #ff7834;
}
.entry__i:nth-child(2) { border-left-color: #8b5cf6; }
.entry__i:nth-child(3) { border-left-color: #2b86d9; }
.entry__i--press { transform: scale(0.97); opacity: 0.9; }
.entry__name { font-size: 28rpx; font-weight: 700; color: #1e1e1e; }
.entry__desc { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* ===== 6. 金刚区两大格（选大学/挑专业）===== */
.king { display: flex; gap: 16rpx; margin: 0 24rpx 24rpx; }
.king__i {
  flex: 1; border-radius: 20rpx; padding: 30rpx 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
  position: relative; overflow: hidden;
}
.king__i--school { background: linear-gradient(135deg, #fff 62%, #fff0e3 100%); }
.king__i--major { background: linear-gradient(135deg, #fff 62%, #E8F4FD 100%); }
.king__i--press { transform: scale(0.97); opacity: 0.92; }
.king__title { font-size: 32rpx; font-weight: 800; color: #1e1e1e; }
.king__sub { font-size: 20rpx; color: #999; margin-top: 8rpx; white-space: nowrap; }
.king__ic { flex-shrink: 0; margin-left: 8rpx; }

/* ===== 7. 冲稳保卡片 ===== */
.bands-card {
  margin: 0 24rpx 24rpx; padding: 24rpx 28rpx 20rpx;
  background: #fff; border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.04);
}
.bands-card__hd { font-size: 28rpx; font-weight: 700; color: #1e1e1e; margin-bottom: 8rpx; }
.hero__bands { display: flex; justify-content: space-around; }
.band { text-align: center; flex: 1; }
.band__num { display: block; font-size: 52rpx; font-weight: 800; line-height: 1.1; }
.band--chong .band__num { color: #f94b37; }
.band--wen  .band__num { color: #F39C12; }
.band--bao  .band__num { color: #27AE60; }
.band__bot { display: flex; align-items: center; justify-content: center; gap: 4rpx; margin-top: 4rpx; }
.band__label { font-size: 24rpx; color: #999; font-weight: 500; }
.band__arrow { font-size: 28rpx; color: #ccc; font-weight: 300; }

/* 通用按压反馈 */
.grid__i--press { background: #f2f2f2; }
.act--press { transform: scale(0.97); opacity: 0.92; }

/* ===== 8. 高校排行榜预览 ===== */
.rk-sec { margin: 8rpx 24rpx 0; }
.rk-sec__hd { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 16rpx; }
.rk-sec__title { font-size: 32rpx; font-weight: 700; color: #111; }
.rk-sec__more { font-size: 24rpx; color: #999; }
.rk-scroll { white-space: nowrap; width: 100%; }
.rk-card {
  display: inline-block; vertical-align: top; white-space: normal;
  width: 480rpx; margin-right: 20rpx; padding: 24rpx;
  background: #fff; border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.rk-card:last-child { margin-right: 4rpx; }
.rk-card--press { transform: scale(0.98); transition: transform .08s; }
.rk-card__t { font-size: 28rpx; font-weight: 700; color: #ff5504; margin-bottom: 16rpx; }
.rk-row { display: flex; align-items: center; padding: 10rpx 0; }
.rk-row__n {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  font-size: 24rpx; font-weight: 700; color: #bbb; flex-shrink: 0;
}
.rk-row__n--1 { color: #fff; background: #e0a400; border-radius: 8rpx; }
.rk-row__n--2 { color: #fff; background: #b0b8c4; border-radius: 8rpx; }
.rk-row__n--3 { color: #fff; background: #cd8c5a; border-radius: 8rpx; }
.rk-row__s { flex: 1; font-size: 26rpx; color: #333; margin-left: 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rk-row__m { font-size: 24rpx; color: #999; flex-shrink: 0; margin-left: 12rpx; }

/* ===== 引导文案 ===== */
.tagline { text-align: center; padding: 24rpx 40rpx 48rpx; font-size: 24rpx; color: #bbb; }

/* ===== 艺术类面板 ===== */
.art-panel { margin: 0 24rpx; }
.art-panel__main {
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, #8b5cf6 0%, #b08cf0 100%);
  border-radius: 20rpx; padding: 36rpx 32rpx; color: #fff;
}
.art-panel__t { font-size: 36rpx; font-weight: 800; }
.art-panel__s { font-size: 24rpx; opacity: 0.92; margin-top: 10rpx; }
.art-panel__arrow { font-size: 44rpx; opacity: 0.8; }
.art-grid { display: flex; gap: 16rpx; margin-top: 16rpx; }
.art-cell { flex: 1; background: #fff; border-radius: 16rpx; padding: 24rpx 20rpx; box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.05); }
.art-cell__t { font-size: 28rpx; font-weight: 700; color: #111; }
.art-cell__s { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.art-panel__tip { font-size: 22rpx; color: #999; text-align: center; margin-top: 16rpx; }
