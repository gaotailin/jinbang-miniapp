.page { padding-bottom: 200rpx; }

.hd {
  background: linear-gradient(135deg, #ff7834 0%, #ff5504 100%);
  color: #fff; padding: 48rpx 40rpx 52rpx; display: flex; align-items: center; gap: 16rpx;
  border-radius: 0 0 32rpx 32rpx; margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(255,85,4,0.28);
}
.hd__name { font-size: 42rpx; font-weight: 800; }
.hd__col { display: flex; flex-direction: column; gap: 12rpx; min-width: 0; }
.hd__sub { font-size: 24rpx; color: rgba(255,255,255,0.92); line-height: 1.4; }
.hd__level { color: rgba(255,255,255,0.92); }
/* 橙底上的身份标签：实心半透明白底+白字，对比度更强 */
.hd__tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 4rpx; }
.hd__tag {
  font-size: 22rpx; line-height: 1; color: #ff5504; font-weight: 700;
  border-radius: 8rpx; padding: 8rpx 16rpx; background: rgba(255,255,255,0.95);
}
/* 办学性质：白底透空描边，与实心重点标签区分，仍保持橙底可读 */
.hd__tag--nature {
  color: #fff; background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.65); font-weight: 600;
}
/* 保研资格：绿色资质标记，区别于橙色重点资质 */
.tag--tuimian {
  background: #e8f7ee; color: #1f9d55; border: 1rpx solid #a6e2c0; font-weight: 600;
}

.tip { text-align: center; color: #999; font-size: 26rpx; padding: 40rpx; }

.major-tag { margin: 0; max-width: 100%; }

.stat-row { display: flex; gap: 16rpx; }
.stat { flex: 1; text-align: center; background: #fff6f0; border-radius: 14rpx; padding: 22rpx 8rpx; }
.stat__num { font-size: 38rpx; font-weight: 800; color: #ff5504; font-family: -apple-system, 'DIN Alternate', sans-serif; }
.stat__lbl { font-size: 22rpx; color: #999; margin-top: 8rpx; }

/* 区块标题里的数量角标 */
.sec-count {
  display: inline-block; margin-left: 12rpx; padding: 2rpx 14rpx;
  font-size: 22rpx; font-weight: 600; color: #ff5504; background: #fff0e3;
  border-radius: 20rpx; vertical-align: middle;
}
.grad-note { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.tag--muted { background: #f0f0f0; color: #999; }
.grad-site { font-size: 24rpx; color: #2b86d9; }
.grad-addr { display: block; font-size: 22rpx; color: #888; line-height: 1.5; margin-top: 8rpx; }

.intro { font-size: 26rpx; color: #444; line-height: 1.7; margin-top: 20rpx; }

.row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.row:last-child { border-bottom: none; }
.row__major { font-size: 28rpx; font-weight: 600; color: #111111; }
.row__sub { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.row__r { text-align: right; }
.row__score { font-size: 34rpx; font-weight: 700; color: #ff7834; }
.row__rank { font-size: 22rpx; color: #ff5504; }

.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.97); border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}
.row__l { flex: 1; min-width: 0; }

/* 吸底主按钮：橙渐变实心；已加入态转灰 */
.fav-btn {
  display: flex; align-items: center; justify-content: center;
  height: 96rpx; border-radius: 48rpx; font-size: 30rpx; font-weight: 700;
  color: #fff; background: linear-gradient(90deg, #ff7834, #ff5504);
  box-shadow: 0 8rpx 22rpx rgba(255,85,4,0.3); border: none;
}
.fav-btn::after { border: none; }
.fav-btn--on {
  color: #888; background: #f2f3f5; box-shadow: none;
}
