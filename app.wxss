/* ===========================
   九色鹿前程助手 全局样式 · 设计 Token 单一来源
   【clone-1to1 分支 · 橙色孪生版】1:1 复刻掌上志愿视觉：
      品牌橙 #ff7834（亮，对手主色 349 处）/ 深 #ff5504（渐变终点 122 处）/ 浅底 #fff0e3
   差异化阶段：仅把本文件 page 变量的橙值改回九色鹿红（#C60C0F/#9A080B/#FBEAEA）即可全局换色。
   语义：冲 #EE6666 · 稳 #FAC858 · 保 #3CA272（与行业认知对齐，复刻期保留不动）
   改色/改字号/改圆角：只改本文件的 page 变量，全局生效。
   =========================== */

page {
  /* ---- 品牌色阶（橙 · 掌上志愿 1:1） ---- */
  --brand: #ff7834;          /* 主品牌色：掌上亮橙 */
  --brand-deep: #ff5504;     /* 渐变终点 / 按下态：掌上深橙 */
  --brand-tint: #fff0e3;     /* 品牌浅底（标签/提示底） */
  --brand-grad: linear-gradient(90deg, #ff7834, #ff5504); /* 主 CTA 横向橙渐变（对手灵魂样式） */
  --brand-shadow: 0 20rpx 40rpx rgba(255,85,4,0.12);   /* 橙按钮轻投影 */

  /* ---- 冲 / 稳 / 保 语义色 ---- */
  --chong: #EE6666;
  --wen: #FAC858;
  --bao: #3CA272;

  /* ---- 文字 5 级灰阶（克制，靠颜色拉开层级） ---- */
  --text-1: #1E1E1E;         /* 标题、核心数据 */
  --text-2: #595959;         /* 正文、说明（最高频） */
  --text-3: #A0A0A6;         /* 标签、时间、占位 */
  --text-disabled: #BFBFBF;  /* 禁用 */
  --text-inverse: #FFFFFF;   /* 深底反白 */

  /* ---- 线 / 底 ---- */
  --line: #E6E6E6;           /* 极浅分割线 */
  --bg: #F7F7F7;             /* 页面灰底 */
  --card-bg: #FFFFFF;        /* 卡片白底 */

  /* ---- 字号 8 档（22→40rpx，收敛，勿再新增字号） ---- */
  --fs-min: 22rpx;   /* 最小说明 */
  --fs-tag: 24rpx;   /* 辅助说明、标签 */
  --fs-list: 26rpx;  /* 列表主文字 */
  --fs-base: 28rpx;  /* 正文基准（全局默认） */
  --fs-sub: 30rpx;   /* 次级标题 */
  --fs-title: 32rpx; /* 小标题 */
  --fs-card: 34rpx;  /* 卡片标题 */
  --fs-hero: 40rpx;  /* 页面大标题/核心数字 */

  /* ---- 圆角 3 档 ---- */
  --radius-btn: 8rpx;    /* 按钮、小标签 */
  --radius-card: 16rpx;  /* 卡片默认 */
  --radius-panel: 24rpx; /* 大卡片、弹窗 */

  /* ---- 卡片极轻阴影 ---- */
  --shadow-card: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);

  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  background-color: var(--bg);
  color: var(--text-2);
  font-size: var(--fs-base);
  line-height: 1.6;
  box-sizing: border-box;
  height: 100%;
}

/* ---- 卡片：灰底 + 白卡 + 极轻阴影，靠底色差分模块而非重边框 ---- */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
}
.card--flat { box-shadow: none; border: 2rpx solid var(--line); }

/* ---- 区块标题 ---- */
.sec-title {
  position: relative;
  padding-left: 18rpx;
  font-size: var(--fs-sub);
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.sec-title::before {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 6rpx; height: 26rpx;
  border-radius: 6rpx;
  background: var(--brand);
}

/* ---- 按钮：主按钮统一红渐变 ---- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-btn);
  font-size: var(--fs-base);
  font-weight: 600;
  border: none;
  outline: none;
}
.btn::after { border: none; }
.btn--primary { background: var(--brand-grad); color: var(--text-inverse); box-shadow: var(--brand-shadow); }
.btn--gold    { background: var(--brand-grad); color: var(--text-inverse); box-shadow: var(--brand-shadow); }
.btn--outline { background: transparent; border: 2rpx solid var(--brand); color: var(--brand); }
.btn--ghost   { background: var(--brand-tint); color: var(--brand); }
.btn--block { width: 100%; }
.btn--lg { height: 96rpx; font-size: var(--fs-title); border-radius: var(--radius-card); }
.btn--sm { height: 56rpx; padding: 0 20rpx; font-size: var(--fs-tag); }

/* ---- 标签 ---- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-btn);
  font-size: var(--fs-min);
  font-weight: 500;
}
.tag--primary { background: var(--brand-tint); color: var(--brand-deep); }
.tag--gold    { background: var(--brand-tint); color: var(--brand-deep); }
.tag--blue    { background: rgba(41, 128, 185, 0.08); color: #2980B9; }
.tag--green   { background: rgba(60, 162, 114, 0.10); color: var(--bao); }
.tag--gray    { background: #f0f0f0; color: var(--text-2); }

/* ---- 进度条 ---- */
.bar { height: 14rpx; background: #f0f0f0; border-radius: 999rpx; overflow: hidden; }
.bar__fill { height: 100%; background: var(--brand); border-radius: 999rpx; transition: width .3s; }
.bar__fill--gold { background: var(--brand-grad); }

/* ---- 分割线 ---- */
.divider { height: 1rpx; background: var(--line); margin: 16rpx 0; }

/* ---- 工具类 ---- */
.flex        { display: flex; }
.flex-col    { display: flex; flex-direction: column; }
.flex-wrap   { flex-wrap: wrap; }
.items-center{ align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center  { justify-content: center; }
.flex-1      { flex: 1; }
.gap-12      { gap: 12rpx; }
.gap-16      { gap: 16rpx; }
.gap-20      { gap: 20rpx; }
.text-center { text-align: center; }
.text-primary   { color: var(--brand); }
.text-gold      { color: var(--brand-deep); }
.text-secondary { color: var(--text-2); }
.text-muted     { color: var(--text-3); }
.font-bold   { font-weight: 700; }
.font-600    { font-weight: 600; }
.text-sm     { font-size: var(--fs-tag); }
.text-xs     { font-size: var(--fs-min); }
.text-lg     { font-size: var(--fs-title); }
.text-xl     { font-size: var(--fs-card); }
.mt-8  { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.ml-8  { margin-left: 8rpx; }
.mr-8  { margin-right: 8rpx; }
.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }
